[Desktop Entry]
Name=dwarf2json
Comment=Processing DWARF and symbol table information from ELF files and symbols from System.map
Encoding=UTF-8
Exec=parrot-exec --hint "see github.com/volatilityfoundation/dwarf2json" "dwarf2json --help"
Icon=parrot_foremost
StartupNotify=false
Terminal=true
Type=Application
Categories=11-forensics;
