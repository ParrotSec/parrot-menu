[Desktop Entry]
Name=bluesnarfer
Comment=Access to calendars, contact lists, emails and text messages, and even pictures and private videos through a Bluetooth connection
Encoding=UTF-8
Exec=parrot-exec --hint "see github.com/dhchoi/bluesnarfer" --sudo bluesnarfer
Icon=xterm
StartupNotify=false
Terminal=true
Type=Application
Categories=06-02-bluetooth-tools;
