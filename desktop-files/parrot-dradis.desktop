[Desktop Entry]
Name=dradis
Comment=Web interface reporting tool for security assessments
Encoding=UTF-8
Exec=parrot-exec --gui sh -c "systemctl start dradis 2>/dev/null; xdg-open https://127.0.0.1:3004"
Icon=parrot_dradis
StartupNotify=false
Terminal=false
Type=Application
Categories=12-reporting;
X-Parrot-Package=dradis
